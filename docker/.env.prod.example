WORKING_DIR=/workspace
SPLENT_APP=isia_wiki
PYTHONPATH=/workspace/isia_wiki/src
FLASK_APP=isia_wiki:create_app

MARIADB_HOSTNAME=isia_wiki_db_deploy
MARIADB_DATABASE=<SET>
MARIADB_USER=<SET>
MARIADB_PASSWORD=<SET>
MARIADB_ROOT_PASSWORD=<SET>

RUN_DB_SEED=false

# Host interfaces for the ports published by docker-compose.prod.yml.
# 127.0.0.1 keeps them reachable only from the host itself, the right setup
# when a proxy on the host terminates TLS and forwards to loopback. Set a
# variable to 0.0.0.0, or delete its line, to publish on all interfaces.
# user-tunable
SPLENT_WEB_BIND_HOST=127.0.0.1
# user-tunable
SPLENT_DB_BIND_HOST=127.0.0.1

# Persistent data directories inside the web container. They are the mount
# targets of the named volumes declared in docker-compose.prod.yml, so their
# contents survive redeploys. PROTECTED_UPLOADS_DIR holds uploads served
# through the app (outside static/), ARCHIVE_DIR holds extra static content.
# Change a path only together with the matching volume in the compose file.
# user-tunable
PROTECTED_UPLOADS_DIR=/workspace/isia_wiki/protected_uploads
# user-tunable
ARCHIVE_DIR=/workspace/isia_wiki/archive

# ── The subject this wiki serves ────────────────────────────────────────
COURSES_NAME_PREFIX=ISIA
COURSES_DESCRIPTION_TEMPLATE=Material docente de Ingeniería del Software, curso {year}
COURSES_DEFAULT_CATEGORIES=Teoría,Prácticas,Proyecto,Evaluación

# The wiki is taught in Spanish, so Spanish is what a reader gets unless
# they ask for otherwise. English stays available for exchange students.
BABEL_DEFAULT_LOCALE=es
BABEL_SUPPORTED_LOCALES=es,en

# What the site calls itself in its own header. Without it the
# theme falls back to SPLENT_APP, which is the package name and
# not what anybody types into a browser.
SITE_NAME=isia.us.es

# What the empty search box invites a reader to do.
SEARCH_PLACEHOLDER=Buscar en esta wiki
